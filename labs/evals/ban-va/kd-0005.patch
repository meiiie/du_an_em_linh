+ca(L, B3, r"$(v+u)' = v' + u'$ cũng chính là dòng [2].", [bt(r"(v+u)' = v' + u'", CTT, DAT, "d-2", "v+u ≡ u+v")], "nen_hien",
+   "đổi chỗ hạng tử: biểu thức lấy đạo hàm trùng dòng [2] theo SymPy")
+ca(L, B3, r"Em nhớ dòng [1]: $(x^n)'=nx^{n-1}$.", [bt(r"(x^n)'=nx^{n-1}", CTT, DAT, "d-1")], "nen_hien", "không khoảng trắng")
+ca(L, HT, r"Dòng [3] cho $\left(\dfrac{u}{v}\right)'=\dfrac{u'v-uv'}{v^{2}}$.",
