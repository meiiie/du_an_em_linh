+# Kiểm bằng SymPy mọi căn cứ toán của KD-0005 (bộ ca lời giảng). Không đọc mã của job kiem-loi-giang: phán quyết
+# mong đợi suy từ ADR 013, còn tệp này kiểm phần toán của từng phán quyết (đúng, sai, phản ví dụ, trùng dòng bảng).
+# Chạy từ gốc repo: python services/math/kiemdinh/loi-giang/kiem_bo_ca.py services/math/kiemdinh/loi-giang/bo-ca-loi-giang.yaml
+import re
+import sys
+
+import sympy as sp
+import yaml
+from sympy.parsing.sympy_parser import implicit_multiplication_application, parse_expr, standard_transformations
+
+BIEN_DOI = standard_transformations + (implicit_multiplication_application,)
+
+BO = yaml.safe_load(open(sys.argv[1], encoding="utf-8"))
+CA = {c["id"]: c for c in BO["ca"]}
+BANG = {r["id"]: r for r in BO["ngu_canh"]["bang_cong_thuc"]}
+BAI = BO["ngu_canh"]["bai"]
+
+x, n, k, a, b = sp.symbols("x n k a b")
+u, v, f, g = (sp.Function(t)(x) for t in "uvfg")
+D = lambda e: sp.diff(e, x)  # noqa: E731
+
+ket_qua = []
+
+
+def ghi(ma, dat, mo_ta):
+    ket_qua.append((ma, dat, mo_ta))
+
+
+def bang_nhau(e1, e2):
+    return sp.simplify(sp.expand(e1 - e2)) == 0
+
+
+def the(e, **mau):
+    """Thế hàm mẫu cho u, v (hàm ký hiệu) rồi tính đạo hàm."""
+    thay = {sp.Function(t): sp.Lambda(x, bt) for t, bt in mau.items()}
+    return sp.simplify(e.subs(thay).doit())
+
+
+# ---- dòng bảng: các đẳng thức của bảng v0 đúng; E (biểu thức lấy đạo hàm) của từng dòng
+E_DONG = {"d-1": x**n, "d-2": u + v, "d-3": u / v}
+ghi("dòng d-1", bang_nhau(D(x**n), n * x**(n - 1)), "(x^n)' = n x^{n-1}")
+ghi("dòng d-2", bang_nhau(D(u + v), D(u) + D(v)), "(u+v)' = u' + v'")
+ghi("dòng d-3", bang_nhau(D(u / v), (D(u) * v - u * D(v)) / v**2), "(u/v)' = (u'v − uv')/v²")
+
+
+def khop_dong(E):
+    return [m for m, Er in E_DONG.items() if bang_nhau(E, Er)]
+
+
+# ---- loại 1: trùng dòng bảng theo SymPy (E và vế phải)
+for ma, E, VP, dong in [
+    ("LG-1-01", x**n, n * x**(n - 1), "d-1"), ("LG-1-06", x**n, n * x**(n - 1), "d-1"), ("LG-1-12", x**n, n * x**(n - 1), "d-1"),
+    ("LG-1-02", u + v, D(u) + D(v), "d-2"), ("LG-1-05", u + v, D(u) + D(v), "d-2"), ("LG-1-11", v + u, D(v) + D(u), "d-2"),
+    ("LG-1-03", u / v, (D(u) * v - u * D(v)) / v**2, "d-3"), ("LG-1-04", u / v, (D(u) * v - u * D(v)) / v**2, "d-3"),
+    ("LG-1-13", u / v, (D(u) * v - u * D(v)) / v**2, "d-3"), ("LG-1-14", u / v, D(u) / v - u * D(v) / v**2, "d-3"),
+]:
+    ghi(ma, khop_dong(E) == [dong] and bang_nhau(D(E), VP), f"E trùng dòng {dong}, vế phải bằng đạo hàm của E")
+# dòng định lí: nguyên văn LaTeX của dòng (sau gộp khoảng trắng)
+gop = lambda s: re.sub(r"\s+", " ", s).strip()  # noqa: E731
+for ma, dong in [("LG-1-07", "d-4"), ("LG-1-08", "d-5"), ("LG-1-09", "d-6")]:
+    ghi(ma, gop(CA[ma]["bieu_thuc"][0]["doan"]) == gop(BANG[dong]["latex"]), f"nguyên văn LaTeX dòng {dong}")
+ghi("LG-1-10", [gop(b["doan"]) for b in CA["LG-1-10"]["bieu_thuc"]] == [gop(BANG["d-2"]["latex"]), gop(BANG["d-3"]["latex"])],
+    "hai dòng d-2, d-3 nguyên văn")
+
+# ---- loại 2: đúng toán học, E không trùng dòng nào
+for ma, E, VP in [
+    ("LG-2-01", u * v, D(u) * v + u * D(v)), ("LG-2-02", u - v, D(u) - D(v)), ("LG-2-03", k * u, k * D(u)),
+    ("LG-2-04", sp.sin(x), sp.cos(x)), ("LG-2-05", sp.cos(x), -sp.sin(x)), ("LG-2-06", sp.exp(x), sp.exp(x)),
+    ("LG-2-07", sp.log(x), 1 / x), ("LG-2-08", sp.sqrt(x), 1 / (2 * sp.sqrt(x))), ("LG-2-09", 1 / v, -D(v) / v**2),
+    ("LG-2-10", u**n, n * u**(n - 1) * D(u)), ("LG-2-14", sp.tan(x), 1 / sp.cos(x)**2),
+]:
+    ghi(ma, bang_nhau(D(E), VP) and not khop_dong(E), "đúng, E không trùng dòng bảng")
+fg = sp.Function("f")(sp.Function("g")(x))
+ghi("LG-2-11", bang_nhau(D(sp.sin(x**2)), sp.cos(x**2) * 2 * x) and not khop_dong(fg), "quy tắc hàm hợp (thử f = sin, g = x²)")
+ghi("LG-2-12", bang_nhau(sp.expand((a + b)**2), a**2 + 2 * a * b + b**2), "hằng đẳng thức đúng")
