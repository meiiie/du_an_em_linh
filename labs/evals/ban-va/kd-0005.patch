+ghi("LG-2-13", all(sp.solveset(D(h) <= 0, x, sp.S.Reals) == sp.S.EmptySet and h.subs(x, 1) > h.subs(x, 0) for h in mau_dd1),
+    "DD1: hàm mẫu có y' > 0 trên ℝ đều tăng (không phải chứng minh)")
+
+# ---- loại 3: sai, bác bằng hàm mẫu cụ thể (vế trái − vế phải ≠ 0)
+for ma, trai, phai, mau in [
+    ("LG-3-01", D(u * v), D(u) * D(v), {"u": x, "v": x}),
+    ("LG-3-02", D(u / v), (D(u) * v + u * D(v)) / v**2, {"u": sp.Integer(1), "v": x}),
