index 0000000..619171e
--- /dev/null
+++ b/services/math/kiemdinh/loi-giang/mo_phong_tu_vung.py
@@ -0,0 +1,215 @@
+# Mô phỏng tham chiếu của `cach_dung` trong tu-vung-quy-tac.yaml (KD-0005 bản 2, ADR 013 mục 2), và tự kiểm bộ ca với nó.
+# Không phải job kiem-loi-giang: chỉ phần «câu nào là ứng viên quy tắc bằng lời, ứng viên nào trùng câu bảng». Bộ nhận
+# dạng tầng 2 (diễn đạt lại một dòng) không mô phỏng ở đây, nên ca mong [DAT, KHONG_KIEM_DUOC] chỉ kiểm phần ứng viên.
+# Chạy từ gốc repo:
+#   python services/math/kiemdinh/loi-giang/mo_phong_tu_vung.py services/math/kiemdinh/loi-giang \
+#       [specs/001-lat-cat-doc/doi-chieu/phan-hoi-toan.json]
+# Tham số thứ hai (tùy chọn): đo tỉ lệ câu gợi ý thật của v0 (thang_goi_y trong tệp vàng T013) thành ứng viên.
+import json
+import pathlib
+import re
+import sys
+import unicodedata
+
+import yaml
+
+THU_MUC = pathlib.Path(sys.argv[1])
+TV = yaml.safe_load((THU_MUC / "tu-vung-quy-tac.yaml").read_text(encoding="utf-8"))
+BO = yaml.safe_load((THU_MUC / "bo-ca-loi-giang.yaml").read_text(encoding="utf-8"))
+
+TOAN = re.compile(r"\$\$.+?\$\$|\$.+?\$|\\\(.+?\\\)|\\\[.+?\\\]", re.S)
+TU = re.compile(r"\w+|:")
+CHE = ""  # ký tự che đoạn toán: không phải \w, không phải dấu tách câu
+QT, DAT = "QUY_TAC_BANG_LOI", "DAT"
+
+
+def bo_dau(s):
+    s = s.replace("đ", "d").replace("Đ", "D")
+    return "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn")
+
+
+def che_toan(s):
+    """Thay mỗi đoạn toán bằng chuỗi ký tự che cùng độ dài, để vị trí trong câu gốc giữ nguyên."""
+    return TOAN.sub(lambda m: CHE * len(m.group(0)), s)
+
+
+def tach_cau(s):
+    """Luật 1: tách tại . ; ? ! và xuống dòng, trừ trong ngoặc, trong đoạn toán, hay dấu chấm giữa hai chữ số.
+    Trả các cặp (câu gốc, câu đã che toán)."""
+    s = unicodedata.normalize("NFC", s)
+    che = che_toan(s)
+    out, dau, sau = [], 0, 0
+    for i, ch in enumerate(che):
+        if ch in "([{":
+            sau += 1
+        elif ch in ")]}":
+            sau = max(0, sau - 1)
+        elif ch in ".;?!\n" and sau == 0 and not (ch == "." and 0 < i < len(che) - 1 and che[i - 1].isdigit() and che[i + 1].isdigit()):
+            out.append((s[dau:i + 1], che[dau:i + 1]))
+            dau = i + 1
+    out.append((s[dau:], che[dau:]))
+    return [(g.strip(), c.strip()) for g, c in out if g.strip()]
+
+
+# Luật 3: mục từ vựng → dãy từ; nhãn T (thuật ngữ) / Q (quan hệ). «nếu … thì» không thêm phép khớp (luật 7).
+MUC = {}
+for ten, nhan in (("thuat_ngu", "T"), ("tu_quan_he", "Q")):
+    for m in TV[ten]:
+        if "…" in m:
+            continue
+        tu = tuple(TU.findall(unicodedata.normalize("NFC", m).lower()))
+        MUC.setdefault(tu, set()).add(nhan)
+DAI_NHAT = max(len(t) for t in MUC)
+
+
+def tu_khop(tu_cau, tu_muc):
+    """Luật 4: từ có dấu khớp đúng từ; từ toàn ASCII khớp cả dạng bỏ dấu của từ trong mục."""
+    return tu_cau == tu_muc or (tu_cau.isascii() and tu_cau == bo_dau(tu_muc))
+
+
+def cum(che):
+    """Luật 2–3: các cụm (vị trí, từ, nhãn) theo khớp dài nhất, trái sang phải, không chồng nhau."""
+    tu = TU.findall(unicodedata.normalize("NFC", che).lower())
+    out, i = [], 0
+    while i < len(tu):
+        if tu[i] == ":":
+            out.append((i, ":", {":"}))
+            i += 1
+            continue
+        lay = None
+        for k in range(min(DAI_NHAT, len(tu) - i), 0, -1):
+            for muc, nhan in MUC.items():
+                if len(muc) == k and all(tu_khop(tu[i + p], muc[p]) for p in range(k)):
+                    lay = (" ".join(tu[i:i + k]), nhan)
+                    break
+            if lay:
+                break
+        if lay:
+            out.append((i, lay[0], lay[1]))
+            i += len(lay[0].split())
+        else:
+            i += 1
+    # Luật 5: dấu hai chấm là quan hệ khi có cụm thuật ngữ ở cả trước lẫn sau nó.
+    ket = []
+    for vt, chu, nhan in out:
+        if nhan == {":"}:
+            truoc = any("T" in n for v, _, n in out if v < vt)
+            sau = any("T" in n for v, _, n in out if v > vt)
+            nhan = {"Q"} if truoc and sau else set()
+        ket.append((vt, chu, nhan))
+    return ket
+
+
+def ung_vien(che):
+    """Luật 6: có hai cụm khác nhau, một mang nhãn T, một mang nhãn Q. Trả (là ứng viên, cặp minh họa)."""
+    c = cum(che)
+    for a in c:
+        for b in c:
+            if a[0] != b[0] and "T" in a[2] and "Q" in b[2]:
+                return True, (a[1], b[1])
+    return False, ("", "")
+
+
+def chuan_bang(s):
+    return re.sub(r"[\s.,;:!?]+", " ", unicodedata.normalize("NFC", s).lower()).strip()
+
+
+CAU_BANG = {}
+for r in BO["ngu_canh"]["bang_cong_thuc"]:
+    for g, _ in tach_cau(r["phat_bieu"]):
+        CAU_BANG[chuan_bang(g)] = r["id"]
+
+
+def gop(s):
+    return re.sub(r"\s+", " ", unicodedata.normalize("NFC", s)).strip()
+
+
+def bo_cham_cuoi(s):
+    return re.sub(r"[.;?!]+$", "", s).strip()
+
+
+def danh_sach(x):
+    return x if isinstance(x, list) else [x]
+
+
+loi, ghi_chu = [], []
+dem_qt = 0
+for c in BO["ca"] + BO["doi_chung"]:
+    cau = tach_cau(c["cau"])
+    thong_tin = []
+    for g, che in cau:
+        uv, cap = ung_vien(che)
+        thong_tin.append({"goc": g, "uv": uv, "cap": cap, "bang": CAU_BANG.get(chuan_bang(g)), "co_qt": False, "co_dat": False})
+    for b in c["bieu_thuc"]:
+        tt = danh_sach(b["trang_thai"])
+        if QT in danh_sach(b["loai"]):
+            dem_qt += 1
+            noi = [t for t in thong_tin if gop(bo_cham_cuoi(t["goc"])) == gop(b["doan"])]
+            if not noi and len(danh_sach(b["loai"])) > 1:
+                continue  # mảnh trong câu (ví dụ toán viết trần), QT chỉ là một cách phân loại được nhận
+            if not noi:
+                loi.append(f"{c['id']}: đoạn QT «{b['doan']}» không trùng câu nào sau khi tách câu")
+                continue
+            t = noi[0]
+            t["co_qt"] = True
+            if not t["uv"]:
+                loi.append(f"{c['id']}: «{t['goc']}» mong là ứng viên quy tắc nhưng từ vựng không bắt (LỌT)")
+            if tt == [DAT] and t["bang"] != b.get("dong_bang"):
+                loi.append(f"{c['id']}: «{t['goc']}» mong trùng câu bảng {b.get('dong_bang')}, mô phỏng ra {t['bang']}")
+            if DAT not in tt and t["bang"]:
+                loi.append(f"{c['id']}: «{t['goc']}» mong không khớp bảng nhưng trùng câu của {t['bang']}")
+            if DAT in tt and len(tt) > 1 and t["bang"] and t["bang"] != b.get("dong_bang"):
+                loi.append(f"{c['id']}: «{t['goc']}» trùng câu của {t['bang']}, khác dong_bang {b.get('dong_bang')}")
+        elif tt == [DAT]:
+            for t in thong_tin:
+                if gop(b["doan"]) in gop(t["goc"]):
+                    t["co_dat"] = True
+    giu_ca_cau = c["muc"] == "nen_hien" and not c["bieu_thuc"]
+    for t in thong_tin:
+        if t["co_qt"]:
+            continue
+        if (t["co_dat"] or giu_ca_cau) and t["uv"] and not t["bang"]:
+            loi.append(f"{c['id']}: «{t['goc']}» phải giữ nhưng là ứng viên quy tắc không khớp bảng ({t['cap'][0]} + {t['cap'][1]})")
+        elif t["uv"] and not t["bang"]:
+            ghi_chu.append(f"{c['id']}: «{t['goc']}» ({t['cap'][0]} + {t['cap'][1]})")
+
+print(f"Đoạn QUY_TAC_BANG_LOI đã kiểm: {dem_qt}; câu phải giữ đã kiểm không là ứng viên.")
+print(f"Câu ở ca phai_bo cũng là ứng viên (bỏ theo hai đường, không phải lỗi): {len(ghi_chu)}")
+for g in ghi_chu:
+    print("  ·", g)
+
+if len(sys.argv) > 2:
+    goi = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
+    chu = set()
+
+    def gom(o):
+        if isinstance(o, dict):
+            if isinstance(o.get("noi_dung"), str):
+                chu.add(o["noi_dung"])
+            for v in o.values():
+                gom(v)
+        elif isinstance(o, list):
+            for v in o:
+                gom(v)
+
+    for g in goi:
+        if g["job"] == "verify":
+            gom(g["yeu_cau"].get("thang_goi_y"))
+    tran = re.compile(r"[=≠≤≥⇒→'′^²³⁴ⁿ⁻√]|\b\d+[a-z]\b|\b[a-z]\s*[+\-*/]\s*\w")
+    cau_goi_y = [(g, che) for s in sorted(chu) for g, che in tach_cau(s)]
+    uv = [(g, ung_vien(che)[1]) for g, che in cau_goi_y if ung_vien(che)[0] and chuan_bang(g) not in CAU_BANG]
+    co_tran = [g for g, che in cau_goi_y if tran.search(che)]
+    hop = {g for g, _ in uv} | set(co_tran)
+    n = len(cau_goi_y)
+    print(f"\nCâu gợi ý v0 (thang_goi_y của {sum(1 for g in goi if g['job'] == 'verify')} bài, {len(chu)} chuỗi khác nhau): {n} câu")
+    print(f"  ứng viên quy tắc không khớp bảng: {len(uv)} ({100 * len(uv) / n:.0f} %)")
+    print(f"  có dấu hiệu toán viết trần (ước lượng thô): {len(co_tran)} ({100 * len(co_tran) / n:.0f} %)")
+    print(f"  ít nhất một trong hai: {len(hop)} ({100 * len(hop) / n:.0f} %)")
+    for g, cap in uv[:12]:
+        print(f"  · «{g}» ({cap[0]} + {cap[1]})")
+
+if loi:
+    print(f"\n{len(loi)} LỖI:")
+    for l in loi:
+        print("  ✗", l)
+sys.exit(1 if loi else 0)
diff --git a/services/math/kiemdinh/loi-giang/tao_bo_ca.py b/services/math/kiemdinh/loi-giang/tao_bo_ca.py
