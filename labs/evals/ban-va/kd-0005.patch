+# Kiểm bằng SymPy mọi căn cứ toán của KD-0005 (bộ ca lời giảng). Không đọc mã của job kiem-loi-giang: phán quyết
+# mong đợi suy từ ADR 013, còn tệp này kiểm phần toán của từng phán quyết (đúng, sai, phản ví dụ, trùng dòng bảng).
+# Chạy từ gốc repo: python services/math/kiemdinh/loi-giang/kiem_bo_ca.py services/math/kiemdinh/loi-giang/bo-ca-loi-giang.yaml
+import re
+import sys
+
+import sympy as sp
+import yaml
+from sympy.calculus.util import continuous_domain
+from sympy.parsing.sympy_parser import implicit_multiplication_application, parse_expr, standard_transformations
+
+BIEN_DOI = standard_transformations + (implicit_multiplication_application,)
+
+BO = yaml.safe_load(open(sys.argv[1], encoding="utf-8"))
+CA = {c["id"]: c for c in BO["ca"]}
+BANG = {r["id"]: r for r in BO["ngu_canh"]["bang_cong_thuc"]}
+BAI = BO["ngu_canh"]["bai"]
+
+x, n, k, a, b = sp.symbols("x n k a b")
+u, v, f, g = (sp.Function(t)(x) for t in "uvfg")
+D = lambda e: sp.diff(e, x)  # noqa: E731
+
+ket_qua = []
+
+
+def ghi(ma, dat, mo_ta):
+    ket_qua.append((ma, dat, mo_ta))
+
+
+def bang_nhau(e1, e2):
+    return sp.simplify(sp.expand(e1 - e2)) == 0
+
+
+def the(e, **mau):
+    """Thế hàm mẫu cho u, v (hàm ký hiệu) rồi tính đạo hàm."""
+    thay = {sp.Function(t): sp.Lambda(x, bt) for t, bt in mau.items()}
+    return sp.simplify(e.subs(thay).doit())
+
+
+# bản 2: công cụ cho phản ví dụ của định lí (điểm thử hai bên x0, cách x0 một khoảng nhỏ)
+SO = sp.Rational(1, 10)
+
+
+def cuc_dai(h, x0):
+    return h.subs(x, x0) > h.subs(x, x0 - SO) and h.subs(x, x0) > h.subs(x, x0 + SO)
+
+
+def cuc_tieu(h, x0):
+    return h.subs(x, x0) < h.subs(x, x0 - SO) and h.subs(x, x0) < h.subs(x, x0 + SO)
+
+
+def dau_hai_ben(h, x0):
+    """Dấu của y' ngay trước và ngay sau x0."""
+    d = D(h)
+    return sp.sign(d.subs(x, x0 - SO)), sp.sign(d.subs(x, x0 + SO))
+
+
+def khong_ham_tai_0(h):
+    """y' không xác định tại 0: hai giới hạn một phía của tỉ sai phân khác nhau (không dùng diff(Abs) — cho 0 sai)."""
+    t = sp.Symbol("t")
+    q = (h.subs(x, t) - h.subs(x, 0)) / t
+    return sp.limit(q, t, 0, "+") != sp.limit(q, t, 0, "-")
+
+
