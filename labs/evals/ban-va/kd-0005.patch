+ghi("LG-5-08", CA["LG-5-08"]["bieu_thuc"][0]["doan"] in BAI["BAC-BA"]["bai_lam_hoc_sinh"], "trùng dòng học sinh (vẫn bỏ: không «em viết …»)")
+ghi("LG-5-14", CA["LG-5-14"]["bieu_thuc"][0]["doan"] in BAI["BAC-BA"]["bai_lam_hoc_sinh"], "trùng nguyên văn dòng học sinh")
+ghi("LG-5-15", CA["LG-5-15"]["bieu_thuc"][0]["doan"] in BAI["HUU-TI"]["bai_lam_hoc_sinh"], "trùng nguyên văn dòng học sinh")
+
+
+# ---- loại 7: chuẩn hóa cách viết (khoảng trắng, ^ / **, dấu nhân, ngoặc nhọn số mũ, \frac) không rút gọn
+def chuan(s):
+    s = re.sub(r"^\s*y\s*=\s*", "", s)
+    s = re.sub(r"\\d?frac\{([^{}]*)\}\{([^{}]*)\}", r"(\1)/(\2)", s)
+    s = s.replace("**", "^").replace("*", "")
+    s = re.sub(r"\^\{([^{}]*)\}", r"^\1", s)
+    return re.sub(r"\s+", "", s)
