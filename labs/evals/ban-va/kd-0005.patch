+    if c["loai_ca"] == 8 and c["muc"] == "nen_hien" and c["bieu_thuc"][0]["trang_thai"] == "DAT":
+        dong = c["bieu_thuc"][0]["dong_bang"]
+        ghi(ma, gop(c["cau"]).rstrip(".").lower() in cau_cua[dong], f"là một câu của phát biểu dòng {dong} (sau chuẩn hóa)")
