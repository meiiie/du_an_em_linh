+ghi("LG-8-15", tich_sai, "«tích các đạo hàm» sai: u = v = x")
+ghi("LG-8-16", D(-x) < 0 and (-x).subs(x, 1) < (-x).subs(x, 0), "«đạo hàm âm thì đồng biến» sai: y = −x")
+ghi("LG-8-17", D(x**3).subs(x, 0) == 0 and dau_hai_ben(x**3, 0) == (1, 1), "«đạo hàm bằng 0 thì cực trị» sai: y = x³ tại 0")
+ghi("LG-8-18", the(D(u / v) - D(u) / D(v), u=x**2, v=x) != 0, "«thương các đạo hàm» sai: u = x², v = x")
+ghi("LG-8-19", khong_ham_tai_0(sp.Abs(x)) and cuc_tieu(sp.Abs(x), 0),
+    "y = |x|: 0 thuộc TXĐ, y' không xác định tại 0 (giới hạn một phía 1 và −1), 0 là điểm tới hạn mà không là nghiệm của y' = 0")
+ghi("LG-8-20", dau_hai_ben(x**2, 0) == (-1, 1) and cuc_tieu(x**2, 0), "«âm sang dương thì cực đại» sai: y = x², 0 là cực tiểu")
+ghi("LG-8-21", the(D(u + v) - D(u) * D(v), u=x, v=x) != 0, "«với tổng … tích các đạo hàm» sai: u = v = x")
+for ma in ["LG-8-22", "LG-8-23", "LG-8-24"]:
+    ghi(ma, gop(dv(ma)).lower() in cau_cua["d-2"] and tich_sai, "câu đầu là câu của dòng d-2; câu sau kế thừa thành (uv)' = u'v', sai")
+for ma in ["LG-8-25", "LG-8-26", "LG-8-27", "LG-8-28", "LG-8-29", "LG-8-30", "LG-8-43", "LG-8-44"]:
+    ghi(ma, tich_sai, "(uv)' ≠ u'v': u = v = x")
+ghi("LG-8-31", the(D(u / v) - D(u) / D(v), u=x**2, v=x) != 0, "(u/v)' ≠ u'/v': u = x², v = x")
+for ma in ["LG-8-32", "LG-8-41"]:
+    ghi(ma, D(x**3).subs(x, 0) == 0 and dau_hai_ben(x**3, 0) == (1, 1), "y = x³: y'(0) = 0, y' không đổi dấu, 0 không là cực trị")
+ghi("LG-8-33", hq.subs(x, -1) == -2 and cuc_dai(hq, -1) and sp.limit(hq, x, 1, "+") == sp.oo,
+    "bài hữu tỉ: giá trị cực đại y(−1) = −2 nhưng y → +∞ khi x → 1⁺, không có giá trị lớn nhất")
+ghi("LG-8-34", cuc_dai(hq, -1) and cuc_tieu(hq, 3) and hq.subs(x, -1) < hq.subs(x, 3), "bài hữu tỉ: cực đại −2 < cực tiểu 6")
+ghi("LG-8-35", D(x) > 0 and x.subs(x, 1) > x.subs(x, 0), "y = x: y' = 1 > 0 mà đồng biến")
+ghi("LG-8-36", (1 / x).subs(x, -1) < (1 / x).subs(x, 1), "y = 1/x: −1 < 1 mà y(−1) = −1 < 1 = y(1): không nghịch biến trên TXĐ")
+ghi("LG-8-37", sp.solveset(D(x**3), x) == sp.FiniteSet(0) and dau_hai_ben(x**3, 0) == (1, 1), "y = x³ không có cực trị")
+ghi("LG-8-38", sp.solveset(D(x**4), x, sp.S.Reals) == sp.FiniteSet(0) and cuc_tieu(x**4, 0), "y = x⁴ chỉ có một điểm cực trị")
+ghi("LG-8-39", D(h3).subs(x, 1) < 0, "y = x³ − 3x² + 2: y'(1) = −3 < 0, không đồng biến trên ℝ")
+ghi("LG-8-40", dong_bien(x**3) and D(x**3).subs(x, -2) > D(x**3).subs(x, -1), "y = x³ đồng biến mà y' = 3x² giảm trên (−∞; 0)")
+ghi("LG-8-42", dong_bien(x**3) and D(x**3).subs(x, 0) == 0, "y = x³ đồng biến mà y'(0) = 0")
+ghi("LG-8-45", sp.diff(k, x) == 0, "đạo hàm của hằng số là 0, không phải 1")
+ghi("LG-8-46", the(D(u / v) - (D(u) * v + u * D(v)) / v**2, u=sp.Integer(1), v=x) != 0, "«u'v cộng uv'» sai: u = 1, v = x")
+ghi("LG-8-47", 0 not in continuous_domain(1 / x, x, sp.S.Reals) and sp.limit(D(1 / x), x, 0, "+") == -sp.oo,
+    "y = 1/x: y' không xác định tại 0 nhưng 0 ∉ TXĐ, nên 0 không là điểm tới hạn")
+ghi("LG-8-48", D(x**3).subs(x, 0) == 0 and dau_hai_ben(x**3, 0) == (1, 1), "y = x³: y'(0) = 0, không đổi dấu, không là cực trị")
+ghi("LG-8-49", sp.solveset(D(h3) < 0, x, sp.S.Reals) == sp.Interval.open(0, 2), "khoảng nghịch biến của bài bậc ba (kết quả)")
+ghi("LG-8-50", cuc_dai(h3, 0) and cuc_tieu(h3, 2), "cực đại tại 0, cực tiểu tại 2 của bài bậc ba (kết quả)")
+
+sai = [r for r in ket_qua if not r[1]]
+for ma, dat, mo_ta in ket_qua:
+    print(("ĐẠT " if dat else "SAI ") + ma + ": " + mo_ta)
+print(f"\n{len(ket_qua) - len(sai)}/{len(ket_qua)} căn cứ đạt")
+sys.exit(1 if sai else 0)
diff --git a/services/math/kiemdinh/loi-giang/mo_phong_tu_vung.py b/services/math/kiemdinh/loi-giang/mo_phong_tu_vung.py
