--- /dev/null
+++ b/services/math/kiemdinh/loi-giang/tao_bo_ca.py
@@ -0,0 +1,559 @@
+# Sinh bản vá KD-0005 (lab Kiểm định): bộ ca lời giảng và từ vựng quy tắc bằng lời (ADR 013, spec SC-004, #89 T029).
+# Câu soạn tay ở đây (chuỗi thô, giữ nguyên gạch chéo của LaTeX); phán quyết mong đợi theo từng mục của ADR 013.
+# Chạy từ gốc repo:
+#   python services/math/kiemdinh/loi-giang/tao_bo_ca.py services/math/kiemdinh/loi-giang data/v0/bang-cong-thuc.json
+#   → bo-ca-loi-giang.yaml, tu-vung-quy-tac.yaml. Kiểm căn cứ toán: python .../kiem_bo_ca.py .../bo-ca-loi-giang.yaml
+import json
+import pathlib
+import sys
+
+import yaml
+
+RA = pathlib.Path(sys.argv[1])
+
+# ---------------------------------------------------------------- ngữ cảnh chung
+BANG_V0 = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))["formulas"]
+TRICH = {  # tài liệu và đoạn trích dẫn chính của từng dòng (bảng khóa của lớp «12A1 thử», #85)
+    "d-1": "sp-tai-lieu-0001", "d-2": "sp-tai-lieu-0001", "d-3": "sp-tai-lieu-0001",
+    "d-4": "v0-don-dieu", "d-5": "sp-tai-lieu-0002", "d-6": "sp-tai-lieu-0002",
+}
+BANG = [
+    {"id": r["ma"], "tieu_de": r["title"], "latex": r["latex"], "phat_bieu": r["noiDung"],
+     "trich_dan": {"tai_lieu": TRICH[r["ma"]]}}
+    for r in BANG_V0
+]
+BAI = {
+    "BAC-BA": {
+        "de": r"Xét tính đơn điệu và tìm cực trị của hàm số $y = x^3 - 3x^2 + 2$.",
+        "ham": "x**3 - 3*x**2 + 2",
+        "bai_lam_hoc_sinh": ["3x^2-6x", "x=0", "x=2"],
+        "du_kien_bao_ve": ["3*x**2 - 6*x", "x = 0", "x = 2", "y(0) = 2", "y(2) = -2"],
+    },
+    "HUU-TI": {
+        "de": r"Xét tính đơn điệu của hàm số $y = \frac{x^2 + 3}{x - 1}$.",
+        "ham": "(x**2 + 3)/(x - 1)",
+        "bai_lam_hoc_sinh": [r"x \ne 1"],
+        "du_kien_bao_ve": ["(x**2 - 2*x - 3)/(x - 1)**2", "x = -1", "x = 3", "y(-1) = -2", "y(3) = 6"],
+    },
+    "TRUNG-PHUONG": {
+        "de": r"Tìm cực trị của hàm số $y = x^4 - 2x^2$.",
+        "ham": "x**4 - 2*x**2",
+        "bai_lam_hoc_sinh": ["4x^3-4x"],
+        "du_kien_bao_ve": ["4*x**3 - 4*x", "x = 0", "x = -1", "x = 1", "y(0) = 0", "y(-1) = -1", "y(1) = -1"],
+    },
+}
+
