# Mẫu cấu hình stack v2; các khóa/mật khẩu để trống, cấp từ môi trường hoặc kho bí mật.
# Compose tự đọc cấu hình host; chạy Maven trực tiếp cần export biến, không tự nạp tệp này.
# Compose demo cố định profile dev và CSDL hoc_toan_core; production dùng profile prod.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hoc_toan_core
SPRING_DATASOURCE_USERNAME=hoc_toan
SPRING_DATASOURCE_PASSWORD=
# Compose demo dùng POSTGRES_PASSWORD, bỏ trống thì dùng mặc định cục bộ của Compose.
POSTGRES_PASSWORD=
# Core dùng PGHOST/PGPORT/PGDATABASE nếu không cấp SPRING_DATASOURCE_URL.
# pg_dump trên host cũng đọc PGUSER/PGPASSWORD/PGPASSFILE/PGSSLMODE.
PGHOST=localhost
PGPORT=5432
PGDATABASE=hoc_toan_core
PGUSER=hoc_toan
PGPASSWORD=
PGPASSFILE=
PGSSLMODE=prefer

# HS256: base64 của ít nhất 32 byte (openssl rand -base64 32).
# Profile prod luôn bắt buộc khóa (kể cả khi bật thêm dev/test) và từ chối khởi động nếu thiếu.
# Profile khác (mặc định, dev, test, staging) mà thiếu khóa thì dùng khóa tạm, phiên mất khi khởi động lại;
# mọi môi trường thật phải bật profile prod.
APP_IDENTITY_JWT_SECRET=
APP_IDENTITY_ACCESS_TOKEN_TTL=PT15M
APP_IDENTITY_ISSUER=hoc-toan-ai-core
APP_IDENTITY_REFRESH_TOKEN_TTL=P30D
APP_IDENTITY_REFRESH_COOKIE_SECURE=true
APP_IDENTITY_LOGIN_FAILURE_CLEANUP_CRON=0 27 3 * * *
# Giới hạn đổi ô bài làm trước khi ghi nhận nghi đoán mò.
APP_PRACTICE_NGUONG_DOAN_MO=4
# CAS: URL đầy đủ thắng APP_MATH_HOSTPORT; Compose dùng http://math:8000.
APP_MATH_BASE_URL=http://localhost:8000
APP_MATH_HOSTPORT=localhost:8000
# Nội dung: image dùng /app/noi-dung; chạy từ services/core dùng ../../data.
APP_CONTENT_SOURCE=../../data
APP_CONTENT_IMPORT_ON_STARTUP=false
# Chỉ dev: mật khẩu tổng hợp; trống thì core tự sinh vào tệp 0600, không ghi log.
MATHL_DEV_SEED_PASSWORD=
MATHL_DEV_SEED_PASSWORD_FILE=/tmp/mathl-dev-seed-password

# Gia sư phía core: khóa trống thì GLM chưa sẵn sàng, dev/test có nhà offline.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.3
GLM_TIMEOUT=45s
GLM_FIRST_TOKEN_TIMEOUT=20s
GLM_MAX_TOKENS=700
GIA_SU_TEMPERATURE=0.8
GIA_SU_TOP_P=0.9
GIA_SU_TOKEN_BUDGET=6000
GLM_RATE_LIMIT_REQUESTS=12
GLM_RATE_LIMIT_WINDOW=10m
# Soạn nháp nội dung phía core, độc lập với khóa gia sư.
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=glm-5.3
# Web Push: cặp P-256 base64url; thiếu khóa thì chỉ nhắc trong ứng dụng.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Chu kỳ kiểm nhắc học (mili giây).
MATHL_PUSH_INTERVAL=60000

# Sandbox SymPy: bộ nhớ mỗi job (MB), số job đồng thời.
MATH_JOB_MEM_MB=512
MATH_JOB_CONCURRENCY=2
# Frontend: biến runtime của nginx và mã phiên bản lúc build; không nhúng khóa vào Angular.
CORE_HOSTPORT=core:8080
SITE_URL=http://localhost:4200
BUILD_SHA=development
GIT_SHA=development
RENDER_GIT_COMMIT=

# Sao lưu: compose (mặc định) hoặc pg (đọc PG* trên host); đường dẫn do bên vận hành cấp.
BACKUP_MODE=compose
BACKUP_DIR=/var/backups/mathl
BACKUP_RETENTION_DAYS=14
BACKUP_COMPOSE_FILE=compose.v2.yaml
BACKUP_COMPOSE_SERVICE=db
# Công cụ thử Z.AI riêng ops/thu-zai.mjs; core không đọc ZAI_* hoặc LLM_* cũ.
ZAI_API_KEY=
ZAI_MODEL=glm-5.3
