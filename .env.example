DATABASE_URL=postgres://hoc_toan:hoc_toan@127.0.0.1:5432/hoc_toan
MATH_SERVICE_URL=http://127.0.0.1:8000

# Cloud: khóa API chính thức (OpenAI / Azure OpenAI tương thích).
# Không dùng device-OAuth ChatGPT hay client_id nội bộ.
# Để trống thì giáo viên phải chọn nhà «offline» — harness không giả làm thang gợi ý khi thiếu khóa.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# OpenRouter — khóa lập trình. Địa chỉ cứng https://openrouter.ai/api/v1 (không nhập URL).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder

# Z.AI — khóa coding (endpoint /api/coding/paas/v4, không API chat tiêu dùng /api/paas/v4).
ZAI_API_KEY=
ZAI_MODEL=glm-5.2

# Local OpenAI-compatible. Harness CHỈ chấp nhận loopback.
# Host khác → từ chối. Lỗi local không chuyển đám mây, không gửi lại.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model

# URL công khai — OAuth callback, canonical SEO, sitemap. Trên Render: RENDER_EXTERNAL_URL hoặc dán APP_URL.
APP_URL=http://127.0.0.1:3000
# Sign in with ChatGPT chính thức (định danh). Chỉ điền client_id OpenAI cấp cho trường.
# Không dùng client_id Codex/CLI. Không có thì thầy cô dán khóa API một lần.
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
