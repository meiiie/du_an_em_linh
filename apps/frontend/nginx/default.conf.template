# Ảnh nginx thay ${CORE_HOSTPORT}, ${SITE_URL} lúc khởi động. envsubst chỉ thay biến môi trường đã khai báo, nên $host, $uri… giữ nguyên.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/xml text/plain application/manifest+json;

    # add_header trong location thay hết add_header của server, nên location nào cũng ghi lại đủ bộ.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Phân giải lại tên core mỗi 10 giây: trên Railway core đổi IP mỗi lần triển khai, nginx giữ IP cũ thì mọi /api/
    # treo (nút Vào học không đi đâu vì guard chờ /api/auth/refresh). NGINX_LOCAL_RESOLVERS do entrypoint của image
    # đọc từ /etc/resolv.conf (Docker: 127.0.0.11, Railway: DNS mạng riêng). proxy_pass dùng biến nên phải có resolver.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;
    set $core_upstream http://${CORE_HOSTPORT};

    # ^~: location regex của tệp tĩnh bên dưới không bắt nhầm đường API.
    location ^~ /api/ {
        proxy_pass $core_upstream;
        proxy_connect_timeout 5s;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        gzip off;
        proxy_set_header Accept-Encoding "";
        add_header X-Accel-Buffering no always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass $core_upstream/actuator/health/readiness;
        proxy_connect_timeout 5s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Tệp build có hash 8 ký tự base64url trong tên (main-5KQ2JHEV.js, chunk-Bo9Sfcq-.js, media/…-AB12cd_4.woff2):
    # cache một năm.
    location ~* "-[a-z0-9_-]{8}\.(?:js|css|woff2?)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # mime.types của nginx không có .webmanifest; thiếu kiểu thì trình duyệt có thể bỏ manifest.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Còn lại (index.html, favicon): hỏi lại mỗi lần để bản mới tới ngay. Đường không phải tệp trả index.html
    # cho định tuyến phía client.
    # index.html, robots.txt, sitemap.xml ghi __SITE_URL__ cho canonical, Open Graph, sitemap (cần URL tuyệt đối):
    # thay bằng SITE_URL của nơi triển khai, không cứng hóa tên miền trong bản build.
    location / {
        sub_filter '__SITE_URL__' '${SITE_URL}';
        sub_filter_once off;
        sub_filter_types text/xml text/plain application/xml;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
