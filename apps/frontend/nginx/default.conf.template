# Ảnh nginx thay ${CORE_URL} lúc khởi động. envsubst chỉ thay biến môi trường đã khai báo, nên $host, $uri… giữ nguyên.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # add_header trong location thay hết add_header của server, nên location nào cũng ghi lại đủ bộ.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ^~: location regex của tệp tĩnh bên dưới không bắt nhầm đường API.
    location ^~ /api/ {
        proxy_pass ${CORE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Tệp build có hash 8 ký tự base64url trong tên (main-5KQ2JHEV.js, chunk-Bo9Sfcq-.js, media/…-AB12cd_4.woff2):
    # cache một năm.
    location ~* "-[a-z0-9_-]{8}\.(?:js|css|woff2?)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # Còn lại (index.html, favicon): hỏi lại mỗi lần để bản mới tới ngay. Đường không phải tệp trả index.html
    # cho định tuyến phía client.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
